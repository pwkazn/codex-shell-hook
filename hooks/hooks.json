{
    "hooks": {
        "SessionStart": [{
            "matcher": "startup|compact",
            "hooks": [{
                "type": "command",
                "command": "node \"${PLUGIN_ROOT}/hooks/reminder.mjs\""
            }]
        }],
        "PreToolUse": [{
            "matcher": "^Bash$",
            "hooks": [{
                "type": "command",
                "command": "node \"${PLUGIN_ROOT}/hooks/adaptor.mjs\""
            }]
        }]
    }
}